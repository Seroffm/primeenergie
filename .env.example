# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# .env.local wird NICHT committed (.gitignore).

# ---------------------------------------------------------------------------
# Supabase – öffentliche Projekt-Daten (sicher im Frontend)
# Zu finden unter: https://app.supabase.com → Projekt → Settings → API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://DEIN_PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Backend-API-URL
# Live:   https://project-gqhfy.vercel.app
# Lokal:  http://localhost:3000
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://project-gqhfy.vercel.app

# ---------------------------------------------------------------------------
# Cloudflare Turnstile – öffentliche Schlüssel, darf VITE_ sein
# ---------------------------------------------------------------------------
# Site Key für das eingebundene Widget (Formular-Seite)
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Server-only (NIEMALS ins Frontend / kein VITE_-Präfix):
# ---------------------------------------------------------------------------

# OpenAI API Key für den öffentlichen Prime Assistenten (/api/chat)
OPENAI_API_KEY=

# Resend E-Mail-Versand für Kundenbestätigungen und interne Lead-Meldungen
RESEND_API_KEY=
EMAIL_FROM=PRIME ENERGIE <info@primeenergie.de>
NOTIFICATION_EMAIL=anfrage@primeenergie.de
APP_URL=https://www.primeenergie.de
OPS_HEALTH_SECRET=

# Wichtig: Nach jeder Änderung einer Vercel Umgebungsvariable muss ein neues
# Production Deployment erstellt werden. Bestehende Deployments behalten alte Werte.

# Supabase Service Role Key (Settings → API → service_role)
# Umgeht RLS — nur serverseitig in API-Routen verwenden!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Turnstile Secret Key (dashboard.cloudflare.com → Turnstile)
# Wenn gesetzt, muss auch VITE_TURNSTILE_SITE_KEY gesetzt sein.
TURNSTILE_SECRET_KEY=
